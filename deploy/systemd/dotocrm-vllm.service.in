[Unit]
Description=dots.mocr vLLM inference server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
Group=@USER@
WorkingDirectory=@ROOT@
EnvironmentFile=@ROOT@/.env
ExecStart=@ROOT@/scripts/run-vllm.sh
# vLLM can exit 0 after an EngineCore subprocess failure.
Restart=always
RestartSec=15
TimeoutStartSec=900
TimeoutStopSec=120
KillSignal=SIGINT
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
