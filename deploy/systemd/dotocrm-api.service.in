[Unit]
Description=dots.mocr API gateway
After=network-online.target dotocrm-vllm.service
Wants=network-online.target dotocrm-vllm.service

[Service]
Type=simple
User=@USER@
Group=@USER@
WorkingDirectory=@ROOT@
EnvironmentFile=@ROOT@/.env
ExecStart=@ROOT@/scripts/run-api.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
