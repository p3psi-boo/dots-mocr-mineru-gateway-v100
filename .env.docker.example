# Required secrets
VLLM_API_KEY=replace-with-an-internal-key
PUBLIC_API_KEY=replace-with-a-public-api-key

# Host paths
DOTOCRM_MODEL_PATH=/opt/dotocrm/models/dots.mocr
DOTOCRM_CACHE_DIR=/opt/dotocrm/cache

# Published gateway listener
DOTOCRM_BIND_ADDRESS=0.0.0.0
DOTOCRM_PUBLIC_PORT=8000

# Mainland China image and Python package mirrors
VLLM_IMAGE=docker.1ms.run/vllm/vllm-openai:v0.11.2
PYTHON_IMAGE=docker.1ms.run/library/python:3.12-slim-bookworm
NODE_IMAGE=docker.1ms.run/library/node:24-bookworm-slim
NPM_REGISTRY=https://registry.npmmirror.com
UV_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
DEBIAN_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian
DEBIAN_SECURITY_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian-security

# Model runtime
VLLM_MODEL=dots-mocr
VLLM_GPU_MEMORY_UTILIZATION=0.88
VLLM_MAX_MODEL_LEN=16384
VLLM_MAX_NUM_SEQS=2
VLLM_MAX_BATCHED_TOKENS=8192

# Gateway limits
MAX_UPLOAD_BYTES=15728640
OCR_MAX_PIXELS=2200000
OCR_MAX_OUTPUT_TOKENS=8192
OCR_TIMEOUT_SECONDS=240
MINERU_PROCESSING_WINDOW_SIZE=64
MINERU_TASK_RETENTION_SECONDS=86400
MINERU_MAX_FILES=8
