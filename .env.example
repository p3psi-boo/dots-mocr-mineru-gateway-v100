# Gateway -> vLLM
VLLM_API_KEY=replace-with-an-internal-key
VLLM_BASE_URL=http://[::1]:8001
VLLM_MODEL=dots-mocr

# Public native OCR endpoint. Empty disables X-API-Key validation.
PUBLIC_API_KEY=replace-with-a-public-api-key

# Gateway process
DOTOCRM_API_HOST=::
DOTOCRM_API_PORT=8010
DOTOCRM_API_WORKERS=1
DOTOCRM_FORWARDED_ALLOW_IPS=::1
MAX_UPLOAD_BYTES=15728640
OCR_MAX_PIXELS=2200000
OCR_MAX_OUTPUT_TOKENS=8192
OCR_TIMEOUT_SECONDS=360
# Concurrent GPU requests; keep equal to VLLM_MAX_NUM_SEQS.
OCR_MAX_INFLIGHT=4
# Abort generation after this many chars of exact repetition (0 disables).
OCR_LOOP_GUARD_CHARS=1024
# 1.0 disables. 1.02-1.05 may break loops; validate OCR quality first.
OCR_REPETITION_PENALTY=1.0

# MinerU compatibility layer
MINERU_PROCESSING_WINDOW_SIZE=64
MINERU_TASK_RETENTION_SECONDS=86400
MINERU_MAX_FILES=8

# vLLM process
DOTOCRM_MODEL_PATH=/opt/dotocrm/models/dots.mocr
DOTOCRM_CACHE_DIR=/opt/dotocrm/cache
DOTOCRM_VLLM_HOST=::
DOTOCRM_VLLM_PORT=8001
CUDA_VISIBLE_DEVICES=0
VLLM_GPU_MEMORY_UTILIZATION=0.88
VLLM_MAX_MODEL_LEN=16384
VLLM_MAX_NUM_SEQS=4
VLLM_MAX_BATCHED_TOKENS=8192
